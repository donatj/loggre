{
  "name": "loggre",
  "version": "1.0.0",
  "description": "Stream processing log reader with automatic gzip detection",
  "module": "dist/main.js",
  "types": "dist/main.d.ts",
  "files": [
    "dist/"
  ],
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "lint": "echo 'No linter configured yet'",
    "lint:fix": "echo 'No linter configured yet'",
    "build": "rollup -c && npm run build-sass",
    "build:dev": "rollup -c --watch",
    "build:prod": "NODE_ENV=production rollup -c",
    "_site": "npm run clean && npm run build && rm -rf _site && mkdir _site && cp -r index.html *.md *.svg dist style _site/",
    "watch": "rollup -c --watch",
    "clean": "rm -rf dist coverage _site",
    "pretest": "npm run clean",
    "build-sass": "sass style/style.scss:style/style.css"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/jest": "^30.0.0",
    "jest": "^29.7.0",
    "rollup": "^2.79.2",
    "sass": "^1.70.0",
    "ts-jest": "^29.4.0",
    "tslib": "^2.8.1",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  }
}
